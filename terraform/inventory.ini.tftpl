# Generated by Terraform -- do not edit by hand.
# The aws_ssm connection plugin addresses hosts by EC2 instance ID, not IP.
#
# Host names differ from group names on purpose: Ansible warns loudly when a
# host and a group share a name.

[web]
web-server ansible_aws_ssm_instance_id=${web_id}

[monitoring]
monitoring-server ansible_aws_ssm_instance_id=${monitoring_id}

[all:vars]
ansible_connection=amazon.aws.aws_ssm
ansible_aws_ssm_region=${region}
ansible_aws_ssm_bucket_name=${transfer_bucket}
ansible_python_interpreter=/usr/bin/python3

# Handy for templates and prometheus targets.
web_private_ip=${web_private_ip}
monitoring_private_ip=${monitoring_private_ip}
ecr_image=${ecr_image}
